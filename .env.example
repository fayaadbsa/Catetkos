# Semua variabel ini OPSIONAL (sudah ada nilai bawaan yang langsung jalan tanpa konfigurasi).

# Server Lokal
PORT=3005
HOST=127.0.0.1
DB_PATH=data/catetkos.db

# Docker Compose (untuk deployment di VPS)
HOST_PORT=3005
COMPOSE_PROJECT=catetkos-prod

# Akun Admin Awal (opsional jika ingin non-interaktif saat npm run seed:admin)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=password-rahasia-minimal-8-karakter
# KOS_NAME="Kos Melati"
