# Semua variabel OPSIONAL (ada nilai bawaan yang langsung jalan tanpa konfigurasi).

# Server lokal
PORT=3005
DB_PATH=data/catetkos.db

# Rahasia tanda tangan sesi JWT. Kosong = dibikin otomatis dan disimpan di data/.session-secret.
# SESSION_SECRET=

# Docker Compose (deployment di VPS)
HOST_PORT=3005
COMPOSE_PROJECT=catetkos-prod

# Akun admin awal (opsional, buat non-interaktif saat bun run seed:admin)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=password-rahasia-minimal-8-karakter
# KOS_NAME="Kos Melati"
