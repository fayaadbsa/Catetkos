{
  "name": "catetkos",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:test": "tsx scripts/seed-test.ts",
    "set:password": "tsx scripts/set-password.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src tests scripts e2e",
    "format": "prettier --write src tests scripts e2e prisma.config.ts next.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "19",
    "react-dom": "19",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
